#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/goto-tmux-pane/previous"

show_help() {
  cat <<'EOF'
Usage: goto-tmux-pane S:W:P
       goto-tmux-pane S:W.P
       goto-tmux-pane --previous
       goto-tmux-pane --help

Arguments:
  S:W:P       Navigate to a pane by session name, window name, and pane title.
  S:W.P       Navigate to a pane by session name, window name, and pane index.

  Before switching, the current pane location is saved (by index) so it can
  be restored with --previous.

Flags:
  --previous  Switch back to the previously saved pane location.
  --help      Show this help message.

Example tmux bindings:
  bind-key g run-shell "goto-tmux-pane 'mysession:mywindow:mypane'"
  bind-key i run-shell "goto-tmux-pane 'mysession:mywindow.0'"
  bind-key b run-shell "goto-tmux-pane --previous"
EOF
}

goto_pane_by_title() {
  local session="$1" window="$2" pane_title="$3"

  tmux switch-client -t "$session"
  tmux select-window -t "$session:$window"

  local pane_id
  pane_id=$(tmux list-panes -t "$session:$window" -F '#{pane_id} #{pane_title}' \
    | awk -v title="$pane_title" '$2 == title { print $1; exit }')

  if [[ -z "$pane_id" ]]; then
    echo "Error: no pane with title '$pane_title' in $session:$window" >&2
    exit 1
  fi

  tmux select-pane -t "$pane_id"
}

goto_pane_by_index() {
  local session="$1" window="$2" pane_index="$3"

  tmux switch-client -t "$session"
  tmux select-window -t "$session:$window"
  tmux select-pane -t "$session:$window.$pane_index"
}

save_current_location() {
  local current_session current_window current_pane_index
  current_session=$(tmux display-message -p '#S')
  current_window=$(tmux display-message -p '#W')
  current_pane_index=$(tmux display-message -p '#{pane_index}')

  mkdir -p "$(dirname "$STATE_FILE")"
  echo "${current_session}:${current_window}.${current_pane_index}" > "$STATE_FILE"
}

parse_and_goto() {
  local target="$1"

  if [[ "$target" =~ ^([^:]+):([^:.]+):(.+)$ ]]; then
    save_current_location
    goto_pane_by_title "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
  elif [[ "$target" =~ ^([^:]+):([^:.]+)\.(.+)$ ]]; then
    save_current_location
    goto_pane_by_index "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
  else
    show_help >&2
    exit 1
  fi
}

if [[ $# -ne 1 ]]; then
  show_help >&2
  exit 1
fi

case "$1" in
  --help)
    show_help
    exit 0
    ;;
  --previous)
    if [[ ! -f "$STATE_FILE" ]]; then
      echo "Error: no previous pane location saved" >&2
      exit 1
    fi
    previous=$(cat "$STATE_FILE")
    save_current_location
    if [[ "$previous" =~ ^([^:]+):([^:.]+)\.(.+)$ ]]; then
      goto_pane_by_index "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
    else
      echo "Error: malformed state file: $previous" >&2
      exit 1
    fi
    ;;
  *)
    parse_and_goto "$1"
    ;;
esac
